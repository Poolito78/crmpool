Windows Registry Editor Version 5.00

; Liens outlook:<EntryID> de MonCRM (bouton "Ouvrir dans Outlook" de l'Agent mail).
; Pour l'utilisateur courant seulement (HKCU), sans droit administrateur.
; Double-cliquer ce fichier une fois par poste. Outlook installe ailleurs :
; corriger le chemin de OUTLOOK.EXE ci-dessous.

[HKEY_CURRENT_USER\Software\Classes\outlook]
@="URL:Outlook"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\outlook\shell\open\command]
@="\"C:\\Program Files\\Microsoft Office\\Root\\Office16\\OUTLOOK.EXE\" /select \"%1\""

; Lien moncrm-agent: (bouton "Rechercher dans Outlook" de l'Agent mail) : lance
; dans l'Outlook deja ouvert une recherche invisible, qui n'ecrit rien dans la
; boite ; sa fin declenche LancerAgentMail (ThisOutlookSession). L'attente garde
; la commande en vie le temps de la recherche.
; L'adresse du lien n'est pas transmise a la commande.

[HKEY_CURRENT_USER\Software\Classes\moncrm-agent]
@="URL:Agent mail MonCRM"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\moncrm-agent\shell\open\command]
@="C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command \"$o=[Runtime.InteropServices.Marshal]::GetActiveObject('Outlook.Application');$b=$o.Session.GetDefaultFolder(6).FolderPath;$f=[char]34+'urn:schemas:httpmail:subject'+[char]34+' = ''moncrm-agent''';[void]$o.AdvancedSearch(''''+$b+'''',$f,$false,'MonCRM-Recherche');Start-Sleep 20\""
